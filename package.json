{
  "name": "flexsmith",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Flexsmith: mobilność, przygotowanie do ruchu, rozciąganie i opcjonalne rolowanie. Offline, dane lokalnie.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node scripts/validate-contrast.mjs && node scripts/validate-content.mjs && vitest run",
    "e2e": "vite build && node tests/e2e/run.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "cap:sync": "npm run build && cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "playwright": "~1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0"
  }
}
